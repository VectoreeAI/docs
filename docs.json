{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Vectoree Docs",
  "colors": {
    "primary": "#07C983",
    "light": "#4ADE80",
    "dark": "#059669"
  },
  "appearance": {
    "default": "dark"
  },
  "styling": {
    "eyebrows": "section"
  },
  "seo": {
    "metatags": {
      "og:site_name": "Vectoree Docs",
      "google-site-verification": "2dSsr0kxw61j9-qSOR0a1dq1PT6U1-2o3kiZMdsIf9g"
    },
    "indexing": "navigable"
  },
  "search": {
    "prompt": "Search Vectoree docs..."
  },
  "favicon": "/favicon.png",
  "navigation": {
    "tabs": [
      {
        "tab": "Docs",
        "groups": [
          {
            "group": "Getting Started",
            "pages": ["introduction", "products", "quickstart"]
          }
        ]
      },
      {
        "tab": "API Reference",
        "groups": [
          {
            "group": "Tables",
            "openapi": "/openapi/tables.yaml"
          },
          {
            "group": "Authentication",
            "openapi": "/openapi/auth.yaml"
          },
          {
            "group": "Records",
            "openapi": "/openapi/records.yaml"
          },
          {
            "group": "Storage",
            "openapi": "/openapi/storage.yaml"
          },
          {
            "group": "Model Gateway",
            "openapi": "/openapi/ai.yaml"
          },
          {
            "group": "Health",
            "openapi": "/openapi/health.yaml"
          }
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "Community",
          "href": "https://discord.gg/SgbKCtqEgT",
          "icon": "discord"
        },
        {
          "anchor": "Blog",
          "href": "https://blog.vectoree.ai",
          "icon": "newspaper"
        },
        {
          "anchor": "GitHub",
          "href": "https://github.com/VectoreeAI/",
          "icon": "github"
        }
      ]
    }
  },
  "redirects": [
    { "source": "/", "destination": "/introduction" }
  ],
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg",
    "href": "https://vectoree.ai"
  },
  "navbar": {
    "primary": {
      "type": "button",
      "label": "Get Started",
      "href": "https://vectoree.ai/dashboard/login"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "cursor",
      "vscode"
    ]
  },
  "footer": {
    "socials": {
      "x": "https://x.com/Vectoree",
      "github": "https://github.com/VectoreeAI/",
      "discord": "https://discord.gg/SgbKCtqEgT"
    }
  }
}
