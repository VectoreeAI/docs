    { "source": "/core-concepts/ai/protocol-compatibility", "destination": "/products" },
    { "source": "/core-concepts/authentication/overview", "destination": "/products" },
    { "source": "/core-concepts/database/overview", "destination": "/products" },
    { "source": "/core-concepts/database/migrations", "destination": "/quickstart" },
    { "source": "/core-concepts/database/pgvector", "destination": "/products" },
    { "source": "/core-concepts/storage/overview", "destination": "/products" },
    { "source": "/core-concepts/storage/s3-compatibility", "destination": "/products" },
    { "source": "/core-concepts/database/branching", "destination": "/quickstart" },
    { "source": "/configuration/config-as-code", "destination": "/quickstart" },
    { "source": "/core-concepts/deployments/overview", "destination": "/products" },
