{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Vectoree Docs",
  "colors": {
    "primary": "#07C983",
    "light": "#4ADE80",
    "dark": "#059669"
  },
  "appearance": {
    "default": "dark"
  },
  "styling": {
    "eyebrows": "section"
  },
  "seo": {
    "metatags": {
      "og:site_name": "Vectoree Docs",
      "google-site-verification": "2dSsr0kxw61j9-qSOR0a1dq1PT6U1-2o3kiZMdsIf9g"
    },
    "indexing": "navigable"
  },
  "search": {
    "prompt": "Search Vectoree docs..."
  },
  "favicon": "/favicon.png",
  "navigation": {
    "languages": [
      {
        "language": "en",
        "default": true,
        "tabs": [
          {
            "tab": "Docs",
            "groups": [
              {
                "group": "Getting Started",
                "pages": [
                  "introduction",
                  "products",
                  "quickstart"
                ]
              },
              {
                "group": "Features",
                "pages": [
                  "models",
                  "auth",
                  "database",
                  "storage",
                  "billing",
                  "deploy",
                  "payments"
                ]
              },
              {
                "group": "Agent Integrations",
                "pages": [
                  "codex"
                ]
              },
              {
                "group": "FAQ",
                "pages": [
                  "faq"
                ]
              }
            ]
          },
          {
            "tab": "API Reference",
            "groups": [
              {
                "group": "Tables",
                "openapi": "/openapi/tables.yaml"
              },
              {
                "group": "Authentication",
                "openapi": "/openapi/auth.yaml"
              },
              {
                "group": "Records",
                "openapi": "/openapi/records.yaml"
              },
              {
                "group": "Storage",
                "openapi": "/openapi/storage.yaml"
              },
              {
                "group": "Model Gateway",
                "openapi": "/openapi/gateway-v1.yaml"
              },
              {
                "group": "Tool Hub",
                "openapi": "/openapi/tool-hub.yaml"
              },
              {
                "group": "Health",
                "openapi": "/openapi/health.yaml"
              }
            ]
          },
          {
            "tab": "Changelog",
            "pages": [
              "changelog"
            ]
          }
        ]
      },
      {
        "language": "zh",
        "tabs": [
          {
            "tab": "文档",
            "groups": [
              {
                "group": "入门",
                "pages": [
                  "zh/introduction",
                  "zh/products",
                  "zh/quickstart"
                ]
              },
              {
                "group": "功能",
                "pages": [
                  "zh/models",
                  "zh/auth",
                  "zh/database",
                  "zh/storage",
                  "zh/billing",
                  "zh/deploy",
                  "zh/payments"
                ]
              },
              {
                "group": "Agent 集成",
                "pages": [
                  "zh/codex"
                ]
              },
              {
                "group": "FAQ",
                "pages": [
                  "zh/faq"
                ]
              }
            ]
          },
          {
            "tab": "接口参考",
            "groups": [
              {
                "group": "数据表",
                "openapi": "/openapi/tables.yaml"
              },
              {
                "group": "身份认证",
                "openapi": "/openapi/auth.yaml"
              },
              {
                "group": "记录",
                "openapi": "/openapi/records.yaml"
              },
              {
                "group": "对象存储",
                "openapi": "/openapi/storage.yaml"
              },
              {
                "group": "模型网关",
                "openapi": "/openapi/gateway-v1.yaml"
              },
              {
                "group": "Tool Hub",
                "openapi": "/openapi/tool-hub.yaml"
              },
              {
                "group": "健康检查",
                "openapi": "/openapi/health.yaml"
              }
            ]
          },
          {
            "tab": "更新日志",
            "pages": [
              "zh/changelog"
            ]
          }
        ],
        "navbar": {
          "primary": {
            "type": "button",
            "label": "开始使用",
            "href": "https://vectoree.ai/dashboard/login"
          }
        }
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "Community",
          "href": "https://discord.gg/SgbKCtqEgT",
          "icon": "discord"
        },
        {
          "anchor": "Blog",
          "href": "https://blog.vectoree.ai",
          "icon": "newspaper"
        },
        {
          "anchor": "GitHub",
          "href": "https://github.com/VectoreeAI/",
          "icon": "github"
        }
      ]
    }
  },
  "redirects": [
    {
      "source": "/",
      "destination": "/introduction"
    },
    {
      "source": "/zh",
      "destination": "/zh/introduction"
    }
  ],
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg",
    "href": "https://vectoree.ai"
  },
  "navbar": {
    "primary": {
      "type": "button",
      "label": "Get Started",
      "href": "https://vectoree.ai/dashboard/login"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "cursor",
      "vscode"
    ]
  },
  "footer": {
    "socials": {
      "x": "https://x.com/vectoreeai",
      "github": "https://github.com/VectoreeAI/",
      "discord": "https://discord.gg/SgbKCtqEgT"
    }
  }
}
